# ─────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# cp .env.example .env
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database — REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_NAME=luckys_home_db
DB_USER=root
DB_PASSWORD=''

# JWT — REQUIRED (change to any long random string)
JWT_SECRET=luckys-home-secret-key-2025-change-this-in-production
JWT_EXPIRES_IN=24h

# Email — OPTIONAL (app works without it, emails just won't send)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_FROM=Lucky's Home <your_email@gmail.com>
# ADMIN_EMAIL=admin@luckys-home.com

MAIL_HOST=mail.luminatewebsol.com
MAIL_USER=Khaled@luminatewebsol.com
MAIL_PASS=Khaled@786
MAIL_PORT=587

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Upload size limits (bytes)
MAX_IMAGE_SIZE=5242880
MAX_DOC_SIZE=10485760
